{
  "name": "frontend-skill-builder",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Private ChatGPT plugin that authors production-ready frontend SKILL.md files, with an MCP server exposing the contract as tools.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm --prefix mcp install --no-audit --no-fund",
    "validate": "node skills/frontend-skill-builder/scripts/validate-plugin.mjs",
    "validate:skill": "node skills/frontend-skill-builder/scripts/validate-skill.mjs",
    "validate:examples": "node skills/frontend-skill-builder/scripts/validate-skill.mjs --all-examples",
    "validate:mcp": "node mcp/scripts/inspect-tools.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "mcp:start": "node mcp/src/server.mjs",
    "package": "node scripts/package-submission.mjs",
    "check": "npm run validate && npm run validate:examples && npm run validate:mcp && npm test"
  }
}